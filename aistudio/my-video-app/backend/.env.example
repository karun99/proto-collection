# AI Studio backend — every key is optional. The system degrades gracefully:
# with zero keys it still produces a captioned video from stock/PIL art and a
# synthesized score. Add keys to unlock cloud generation + narration.

# --- LLM (drives research, proposal, script, scene plan, shot prompts) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=            # optional override; e.g. openrouter/free, claude-3-5-sonnet-latest

# --- Image generation / stock ---
FAL_KEY=              # FLUX image + Veo/Kling video via fal.ai
PEXELS_API_KEY=       # free stock photos + footage
PIXABAY_API_KEY=      # free stock photos + footage
UNSPLASH_ACCESS_KEY=  # free stock photos

# --- Narration (text-to-speech) ---
OPENAI_TTS_VOICE=onyx     # alloy | echo | fable | onyx | nova | shimmer

# --- Music ---
SUNO_API_KEY=
ELEVENLABS_API_KEY=

# --- Server ---
STUDIO_BACKEND_HOST=127.0.0.1
STUDIO_BACKEND_PORT=8787
MAX_CONCURRENT_PRODUCTIONS=2
