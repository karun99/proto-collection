# BlogWriter Web App — Environment Configuration
# Copy to .env and fill in your values.

# OpenRouter API key (BYOK). Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Preferred model (auto-fallback across 25+ free models if this fails)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OCR endpoint (OCR.space, Baidu aip.baidubce.com, or self-hosted)
OCR_ENDPOINT=https://api.ocr.space/parse/image
OCR_API_KEY=

# Encryption key for API keys at rest (AES-256-GCM). Rotate regularly.
BLOGWRITER_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional admin token — when set, all /api calls require header: x-admin-token
ADMIN_TOKEN=

# Scheduler tick interval (ms) for running due jobs
SCHEDULER_TICK_MS=60000

# Port for standalone / Docker deployments
PORT=8080
